     "replace": "static void ir_send_button_from_file(AppState* state, uint32_t button_index);\n\n// Hadal: a submenu is allocated (and added to the view dispatcher) the first time it is shown,\n// not all of them with the app: they cost about 13 KB before anything is open, which a Flipper\n// cannot spare at app start. Once made it stays until the app exits, where main.c removes and\n// frees only those that exist\nstatic Submenu* ghost_esp_submenu(AppState* state, uint32_t view_id) {\n    Submenu** menu = NULL;\n    switch(view_id) {\n    case VIEW_WIFI:\n        menu = &state->wifi_menu;\n        break;\n    case VIEW_WIFI_SCANNING:\n        menu = &state->wifi_scanning_menu;\n        break;\n    case VIEW_WIFI_CAPTURE:\n        menu = &state->wifi_capture_menu;\n        break;\n    case VIEW_WIFI_ATTACK:\n        menu = &state->wifi_attack_menu;\n        break;\n    case VIEW_WIFI_NETWORK:\n        menu = &state->wifi_network_menu;\n        break;\n    case VIEW_WIFI_SETTINGS:\n        menu = &state->wifi_settings_menu;\n        break;\n    case VIEW_STATUS_IDLE:\n        menu = &state->status_idle_menu;\n        break;\n    case VIEW_BLE:\n        menu = &state->ble_menu;\n        break;\n    case VIEW_BLE_SCANNING:\n        menu = &state->ble_scanning_menu;\n        break;\n    case VIEW_BLE_CAPTURE:\n        menu = &state->ble_capture_menu;\n        break;\n    case VIEW_BLE_ATTACK:\n        menu = &state->ble_attack_menu;\n        break;\n    case VIEW_AERIAL:\n        menu = &state->aerial_menu;\n        break;\n    case VIEW_GPS:\n        menu = &state->gps_menu;\n        break;\n    case VIEW_IR:\n        menu = &state->ir_menu;\n        break;\n    case VIEW_IR_REMOTES:\n        menu = &state->ir_remotes_menu;\n        break;\n    case VIEW_IR_BUTTONS:\n        menu = &state->ir_buttons_menu;\n        break;\n    case VIEW_IR_UNIVERSALS:\n        menu = &state->ir_universals_menu;\n        break;\n    case VIEW_WIFI_SETTINGS_LED:\n        menu = &state->wifi_settings_led_menu;\n        break;\n    case VIEW_WIFI_SETTINGS_SD:\n        menu = &state->wifi_settings_sd_menu;\n        break;\n    case VIEW_WIFI_SETTINGS_MGMT:\n        menu = &state->wifi_settings_mgmt_menu;\n        break;\n    case VIEW_WIFI_SETTINGS_DEVICE:\n        menu = &state->wifi_settings_device_menu;\n        break;\n    case VIEW_WIFI_SETTINGS_MISC:\n        menu = &state->wifi_settings_misc_menu;\n        break;\n    case VIEW_WIFI_NETWORK_PORTAL:\n        menu = &state->wifi_network_portal_menu;\n        break;\n    case VIEW_WIFI_NETWORK_CONN:\n        menu = &state->wifi_network_conn_menu;\n        break;\n    case VIEW_WIFI_NETWORK_SCAN:\n        menu = &state->wifi_network_scan_menu;\n        break;\n    case VIEW_WIFI_NETWORK_IOT:\n        menu = &state->wifi_network_iot_menu;\n        break;\n    case VIEW_WIFI_NETWORK_WEBUI:\n        menu = &state->wifi_network_webui_menu;\n        break;\n    case VIEW_BLE_SCAN_DETECT:\n        menu = &state->ble_scan_detect_menu;\n        break;\n    case VIEW_BLE_SCAN_AIRTAG:\n        menu = &state->ble_scan_airtag_menu;\n        break;\n    case VIEW_BLE_SCAN_GATT:\n        menu = &state->ble_scan_gatt_menu;\n        break;\n    case VIEW_BLE_SCAN_ADV:\n        menu = &state->ble_scan_adv_menu;\n        break;\n    case VIEW_GPS_CONFIG:\n        menu = &state->gps_config_menu;\n        break;\n    case VIEW_GPS_WARDRIVE:\n        menu = &state->gps_wardrive_menu;\n        break;\n    default:\n        furi_crash(\"Ghost ESP: no submenu for this view\");\n    }\n    if(!*menu) {\n        *menu = submenu_alloc();\n        view_dispatcher_add_view(state->view_dispatcher, view_id, submenu_get_view(*menu));\n    }\n    return *menu;\n}\n\n// Hadal: the IR lists, allocated the first time one is read (see IrTables in app_state.h) and\n// freed with the app in main.c. Everything that reads them only reads below a count that only\n// the functions filling them (which call this first) make more than zero\nstatic bool ghost_esp_ir_tables(AppState* state) {\n    if(state->ir_tables) return true;\n    IrTables* tables = malloc(sizeof(IrTables));\n    if(!tables) return false;\n    memset(tables, 0, sizeof(IrTables));\n    state->ir_tables = tables;\n    state->ir_remotes = tables->remotes;\n    state->ir_signals = tables->signals;\n    state->ir_universals = tables->universals;\n    state->ir_signal_block_offsets = tables->signal_block_offsets;\n    state->ir_signal_block_lengths = tables->signal_block_lengths;\n    return true;\n}\n"
